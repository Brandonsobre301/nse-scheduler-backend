# Server
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/nse_scheduler

# JWT secret key (REQUIRED — app will not start without this)
JWT_SECRET=my_super_duper_secret_key_hehe

# CORS allowed origin (defaults to http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Shared secret between Express and the FastAPI ai-service — defense-in-depth
# in case app-net is ever reachable from elsewhere. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SERVICE_API_KEY= change_me_to_a_random_64_char_hex_string